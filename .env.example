# Reference only: PHP does not load .env files automatically.
APP_ENV=production
NEEN_APP_KEY=replace_with_at_least_32_random_characters
NEEN_APP_URL=https://example.com

# Set NEEN_DB_DSN instead of NEEN_DB_HOST and NEEN_DB_NAME when preferred.
NEEN_DB_DSN=
NEEN_DB_HOST=localhost
NEEN_DB_NAME=replace_with_database_name
NEEN_DB_USER=replace_with_database_user
NEEN_DB_PASSWORD=replace_with_database_password

NEEN_MAIL_FROM=no-reply@example.com
# Test only; used by tests/auth-api.php.
# NEEN_TEST_MAIL_FILE=/path/to/test-mail-output.jsonl
